{
  "name": "jailops-sim",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,react \"node --watch server/index.js\" \"vite --host 0.0.0.0 --port 5173 --strictPort\"",
    "start": "node server/index.js",
    "user:create": "node scripts/create-user.mjs",
    "build": "tsc -b && vite build",
    "preview": "node server/index.js",
    "test": "npm run build && node --test tests/api.test.js && playwright test",
    "test:api": "node --test tests/api.test.js",
    "package:windows": "npm run build && node scripts/package-windows.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "typecheck": "tsc -b",
    "format": "prettier --write src shared server scripts tests *.ts *.json index.html README.md docs",
    "format:check": "prettier --check src shared server scripts tests *.ts *.json index.html README.md docs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "archiver": "^8.0.0",
    "concurrently": "^10.0.6",
    "extract-zip": "^2.0.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
